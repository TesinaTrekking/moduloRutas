<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>

<VBox alignment="TOP_CENTER"
    spacing="10.0"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.RutaController"
    stylesheets="@styles.css">

    <children>

        <Label text="Listado de Rutas"
            style="-fx-font-size: 24; -fx-font-weight: bold;" />
        <HBox spacing="15.0" alignment="CENTER">

            <VBox spacing="3.0">
                <Label text="Buscar por nombre:" />
                <TextField fx:id="buscarField"
                    promptText="Nombre"
                    prefWidth="180.0" />
            </VBox>

            <VBox spacing="3.0">
                <Label text="Tipo de terreno:" />
                <ComboBox fx:id="filtroTerrenoCombo"
                    prefWidth="140.0" />
            </VBox>

            <VBox spacing="3.0">
                <Label text="Dificultad técnica:" />
                <ComboBox fx:id="filtroDificultadTecnicaCombo"
                    prefWidth="160.0" />
            </VBox>

            <VBox spacing="3.0">
                <Label text="Dificultad física:" />
                <ComboBox fx:id="filtroDificultadFisicaCombo"
                    prefWidth="160.0" />
            </VBox>

            <VBox spacing="3.0" alignment="CENTER">
                <Label text="Estado:" />
                <CheckBox fx:id="mostrarInactivasCheckBox"
                    text="Mostrar inactivas" />
            </VBox>

        </HBox>

        <TableView fx:id="tablaRutas"
            prefHeight="300.0"
            prefWidth="900.0">

            <columns>

                <TableColumn fx:id="colId"
                    prefWidth="50.0"
                    text="ID" />

                <TableColumn fx:id="colNombre"
                    prefWidth="150.0"
                    text="Nombre" />

                <TableColumn fx:id="colLatitudInicial"
                    prefWidth="120.0"
                    text="Latitud inicial" />

                <TableColumn fx:id="colLongitudInicial"
                    prefWidth="120.0"
                    text="Longitud inicial" />
                <TableColumn fx:id="colLatitudFinal" prefWidth="120.0" text="Latitud final" />
                <TableColumn fx:id="colLongitudFinal" prefWidth="120.0" text="Longitud final" />


                <TableColumn fx:id="colAltitudMaxima"
                    prefWidth="120.0"
                    text="Altitud máxima" />

                <TableColumn fx:id="colTipoTerreno"
                    prefWidth="130.0"
                    text="Tipo de terreno" />

                <TableColumn fx:id="colDificultadTecnica"
                    prefWidth="130.0"
                    text="Dificultad técnica" />

                <TableColumn fx:id="colDificultadFisica"
                    prefWidth="130.0"
                    text="Dificultad física" />

            </columns>

        </TableView>

        <HBox spacing="10.0" alignment="CENTER">

            <Button text="Agregar ruta"
                onAction="#switchToForm"
                styleClass="button-save" />

            <Button text="Editar"
                onAction="#editarRuta"
                styleClass="button-edit" />

            <Button text="Eliminar"
                fx:id="eliminarButton"
                onAction="#eliminarRuta"
                styleClass="button-delete" />

        </HBox>

    </children>

    <padding>
        <Insets bottom="20.0"
            left="20.0"
            right="20.0"
            top="20.0" />
    </padding>

</VBox>