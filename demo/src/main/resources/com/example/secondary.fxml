<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20.0"
    xmlns="http://javafx.com/javafx/8.0.171"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.SecondaryController"
    stylesheets="@styles.css">
    
    <Label text="Agregar Nueva Persona" style="-fx-font-size: 20; -fx-font-weight: bold;" />
    
    <GridPane alignment="CENTER" hgap="10" vgap="15">
        <children>
            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nombreField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="apellidoField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Guardar" onAction="#guardarPersona" style="-fx-padding: 10px 20px;" />
        <Button text="Cancelar" onAction="#switchToPrimary" style="-fx-padding: 10px 20px;" />
    </HBox>
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>