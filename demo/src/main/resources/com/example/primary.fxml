<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController" stylesheets="@styles.css">
   <children>
      <Label text="Listado de Personas" style="-fx-font-size: 24; -fx-font-weight: bold;" />
      
      <TableView fx:id="tablaPersonas" prefHeight="300.0" prefWidth="600.0">
         <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="150.0" text="Apellido" />
            <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
         </columns>
      </TableView>

      <HBox spacing="10.0" alignment="CENTER">
         <Button text="Agregar Persona" onAction="#switchToSecondary" style="-fx-padding: 10px 20px; -fx-font-size: 12;" />
         <Button text="Editar" onAction="#editarPersona" style="-fx-padding: 10px 20px; -fx-font-size: 12;" />
         <Button text="Eliminar" onAction="#eliminarPersona" style="-fx-padding: 10px 20px; -fx-font-size: 12;" />
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>